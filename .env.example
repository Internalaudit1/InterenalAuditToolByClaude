POSTGRES_DB=dia_replica
POSTGRES_USER=dia_user
POSTGRES_PASSWORD=dia_password
POSTGRES_PORT=5432
APP_PORT=3000

API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_SECRET_KEY=change-me-in-production
API_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_REFRESH_TOKEN_EXPIRE_DAYS=7
API_STORAGE_ROOT=/app/storage/uploads
